            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Create a new booking request",
                "operationId": "f565d3c9cc8ac61e18bdf09d07a34123",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "booking_date",
                                    "start_time",
                                    "end_time",
                                    "guest_count"
                                ],
                                "properties": {
                                    "table_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "event_id": {
                                        "type": "integer",
                                        "example": 2,
                                        "nullable": true
                                    },
                                    "booking_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-01"
                                    },
                                    "start_time": {
                                        "type": "string",
                                        "example": "19:00"
                                    },
                                    "end_time": {
                                        "type": "string",
                                        "example": "22:00"
                                    },
                                    "guest_count": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "special_requests": {
                                        "type": "string",
                                        "example": "Window side table"
                                    },
                                    "guests": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jane Doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "format": "email",
                                                    "example": "jane@example.com"
                                                },
                                                "phone": {
                                                    "type": "string",
                                                    "example": "+1234567890"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Booking request created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "booking": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error or table occupied"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
