                "operationId": "aed3b1657e966bd5a446564b2f626392",
                "parameters": [
                    {
                        "name": "booking_date",
                        "in": "query",
                        "description": "Booking Date (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-08-01"
                        }
                    },
                    {
                        "name": "start_time",
                        "in": "query",
                        "description": "Start Time (HH:MM)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "19:00"
                        }
                    },
                    {
                        "name": "end_time",
                        "in": "query",
                        "description": "End Time (HH:MM)",
